{
  "name": "@rmariuzzo/mariuzzo.com",
  "version": "0.0.0",
  "description": "The mariuzzo.com web site.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariuzzo/mariuzzo.github.com.git"
  },
